<div class="news-card">
    <div class="card-header">
        <!-- icon -->
         <span class="news-author">@jutrzenka-plock</span>
    </div>

    <div class="info-block">
        <span class="info-date">23/10/2026</span>
        <span class="info-content">Więcej informacji na facebooku Jutrzenka Płock...</span>
    </div>
</div>

<style>
    .news-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 170px;
        border-radius: var(--radius-md);
        background-image:
            linear-gradient(
                to bottom,
                rgba(0, 65, 94, 0.7) 0%,
                rgba(0, 0, 0, 0.7) 100%
            ),
            url('@/assets/hero-bg.jpg');
        background-size: cover;
        background-position: center;
        justify-content: space-between;
    }

    .card-header {
        display: flex;
        flex-direction: row;
        padding: var(--space-sm);
        border-top-left-radius: var(--radius-md);
        border-top-right-radius: var(--radius-md);
        background-color: color-mix(in srgb, var(--color-primary) 70%, transparent);
        font-size: var(--text-xs);
        font-weight: var(--weight-bold);
    }

    .info-block {
        display: flex;
        flex-direction: column;
        border-bottom-left-radius: var(--radius-md);
        border-bottom-right-radius: var(--radius-md);
        border-top: 2px solid transparent;
        border-color: var(--color-light);
        background-color: var(--color-primary-dark);
        height: 70px; /* temporary */
        padding: var(--space-sm);
        gap: var(--space-sm);
        font-size: var(--text-xs);
    }

    .info-date {
        text-decoration: underline;
    }

    .info-content {

    }
</style>