---
interface Props {
    variant?: 'main' | 'secondary';
    author?: string;
    date?: string;
    content?: string;
    bgImage?: string;
}

const {
    variant = 'secondary',
    author = '@jutrzenka-plock',
    date = '24/10/2026',
    content = 'Więcej informacji na facebooku Jutrzenka Płock...',
    bgImage = '@/assets/hero-bg.jpg'
} = Astro.props;
---

<div class={`news-card news-card--${variant}`}>
    <div class="card-header">
        <!-- icon -->
         <span class="news-author">{author}</span>
    </div>

    <div class="info-block">
        <span class="info-date">{date}</span>
        <span class="info-content">{content}</span>
    </div>
</div>

<style>
    .news-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        border-radius: var(--radius-md);
        overflow: hidden;
        color: var(--color-light);

        background-image:
            linear-gradient(
                to bottom,
                rgba(0, 65, 94, 0.7) 0%,
                rgba(0, 0, 0, 0.7) 100%
            ),
            url('@/assets/hero-bg.jpg');
        background-size: cover;
        background-position: center;
        justify-content: space-between;
    }

    .card-header {
        display: flex;
        align-items: center;
        padding: var(--space-sm);
        background-color: color-mix(in srgb, var(--color-primary) 70%, transparent);
        font-size: var(--text-xs);
        font-weight: var(--weight-bold);
    }

    .info-block {
        display: flex;
        flex-direction: column;
        border-top: 2px solid var(--color-light);
        background-color: var(--color-primary-dark);
        padding: var(--space-sm);
        gap: var(--space-sm);
        font-size: var(--text-xs);
    }

    .info-date {
        text-decoration: underline;
        font-weight: var(--weight-medium);
    }

    .info-content {
        font-weight: var(--weight-semibold);

    }

    .news-card--secondary {
        height: 140px;
    }
    .news-card--secondary .info-block {
        min-height: 55px;
    }

    @media (min-width: 1024px) {
        .news-card--secondary {
            height: 170px;
        }
        .news-card--secondary .info-block {
            min-height: 70px;
        }
    }

    .news-card--main {
        height: 220px;
    }
    .news-card--main .info-block {
        min-height: 70px;
    }

    @media (min-width: 1024px) {
        .news-card--main {
            height: 360px; /* Duży kloc po lewej stronie siatki */
        }
        .news-card--main .card-header {
            font-size: var(--text-sm);
            padding: var(--space-md);
        }
        .news-card--main .info-block {
            padding: var(--space-md);
            min-height: 90px;
        }
        .news-card--main .info-content {
            font-size: var(--text-sm);
        }
    }
</style>