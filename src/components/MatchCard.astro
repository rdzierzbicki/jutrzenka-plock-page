---
const { variant = 'default' } = Astro.props;

import Button from '@/components/Button.astro';

import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import lcklogo from '@/assets/lck-logo.png';
import logo from '@/assets/logo.png'

---

<div class={`match-card ${variant}`}>
    <div class="card-header">
        <span class="date"><strong>06/10</strong>Sobota, g. 19:00</span>
        <div class="league-logo"> 
            <Image src={lcklogo} alt="Logo Ligi Centralnej Kobiet" width="80"/>
        </div>
    </div>
    <div class="teams">
        <div class="team-block">
            <Image src={logo} alt="Logo Klubu" width="90"/>
            <span class="team-name">MMKS JUTRZENKA PŁOCK</span>
        </div>
        <div class="vs-block">
            VS
        </div>
        <div class="team-block">
            <Image src={logo} alt="Logo Klubu" width="90"/>
            <span class="team-name">SMS KWIDZYN</span>
        </div>
    </div>
    <div class="card-footer">
        <div class="card-info">
            <span>Hala ZST 70</span>
            <span>ul. Kilińskiego 4a, Płock</span>
        </div>
        <div class="card-buttons">
            <Button href="#" variant="primary" icon="lucide:ticket">
                KUP BILET
            </Button>
            <Button href="#" variant="outline" icon="lucide:tv">
                OGLĄDAJ
            </Button>
        </div>
    </div>
</div>

<style>
    .match-card {
        display: flex;
        flex-direction: column;
        width: 100%;

        background-color: color-mix(in srgb, var(--color-dark) 40%, transparent);
        backdrop-filter: blur(8px);

        border: 2px solid color-mix(in srgb, var(--color-light) 20%, transparent);
        border-radius: var(--radius-md);

        color: var(--color-light);

        margin-bottom: -190px;
    }

    .card-header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-sm) 0;
    }

    .date {
        background-color: var(--color-primary);
        padding: var(--space-xs) var(--space-lg);
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        font-size: var(--text-xs);
        display: inline-flex;
        align-items: center;
    }

    .date strong {
        font-weight: var(--weight-bold);
        margin-right: var(--space-xs); 
    }

    .league-logo {
        padding: 0 var(--space-sm);
    }

    .league-logo :global(img) {
        width: 60px; /* Nieco mniejsze logo ligi na telefonie */
        height: auto;
    }

    .teams {
        display: flex;
        flex-direction: row;
        justify-content: center;
        padding: 0 var(--space-sm);
    }

    .team-block {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-width: 0;
    }

    .vs-block {
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-xl);
        font-weight: var(--weight-medium);
        color: color-mix(in srgb, var(--color-light) 50%, transparent);
        flex-shrink: 0;
    }

    .team-name {
        display: none;
        letter-spacing: -5%;
        white-space: nowrap;
    }

    .card-footer {
        display: flex;
        flex-direction: row;
        padding: var(--space-sm);
        justify-content: space-between;
        align-items: center;
        gap: var(--space-sm);
    }

    .card-info {
        display: flex;
        flex-direction: column;
        font-size: var(--text-xs);
        line-height: 1.2;
    }

    .card-info span:first-child {
        font-weight: var(--weight-bold);
    }

    .card-info span:last-child {
        opacity: 0.8;
    }

    .card-buttons {
        display: flex;
        gap: var(--space-xs);
    }

    @media (min-width: 1024px) {
        .match-card {
            max-width: 460px;
            margin-bottom: -390px;
        }

        .card-header {
            padding: var(--space-sm) 0;
        }

        .date {
            font-size: var(--text-sm);
            padding: var(--space-xs) var(--space-lg);
            min-width: 220px;
        }

        .date strong {
            margin-right: var(--space-sm);
        }

        .league-logo {
            padding: 0 var(--space-lg);
        }

        .league-logo :global(img) {
            width: 80px;
        }

        .teams {
            padding: 0 var(--space-lg);
            gap: var(--space-lg);
        }

        .team-block {
            gap: var(--space-sm);
        }

        .vs-block {
            height: 90px;
            font-size: var(--text-2xl);
        }

        .team-name {
            display: inline-flex;
            font-size: var(--text-sm);
            font-weight: var(--weight-bold);
        }

        .card-footer {
            padding: var(--space-lg);
        }

        .card-info {
            font-size: var(--text-sm);
        }

        .card-buttons {
            gap: var(--space-sm);
        }
    }
</style>