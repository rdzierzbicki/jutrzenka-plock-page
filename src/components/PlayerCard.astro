---
interface Props {
    number: number;
    firstName: string;
    lastName: string;
    position: string;
    image?: string;
}

const {
    number,
    firstName,
    lastName,
    position,
    image = "/assets/player-silhouette.png"
} = Astro.props;
---

<div class="player-card">
    <span class="player-number">{number}</span>

    <div class="player-image-wrapper">
        <img src={image} alt={`${firstName} ${lastName}`} class="player-image" />
    </div>

    <div class="player-info">
        <span class="player-lastname">{lastName}</span>
        <span class="player-firstname">{firstName}</span>
        <span class="player-position">{position}</span>
    </div>
</div>

<style>
    .player-card {
        font-family: 'Holtwood One SC', sans-serif;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        width: 100%;
        height: 280px;
        background-image: 
            linear-gradient(
                color-mix(in srgb, var(--color-dark) 60%, transparent),
                color-mix(in srgb, var(--color-primary-dark) 100%, transparent)
            );
        border-radius: var(--radius-md);
        overflow: hidden;
        text-align: right;
    }

    .player-number {
        
        position: absolute;
        top: 15%;
        left: 50%;
        transform: translate(-50%, 0);
        z-index: 1;
        
        font-size: var(--text-display);
        line-height: 1;
        color: var(--color-light);
        user-select: none;

        text-shadow: 20px 25px 9px rgba(0, 0, 0, 0.6);
    }

    .player-image-wrapper {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 85%;
        z-index: 2;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        pointer-events: none;
    }

    .player-image {
        max-height: 100%;
        width: auto;
        object-fit: contain;
    }

    .player-info {
        padding: var(--space-sm);
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        width: 100%;
        letter-spacing: 10%;
        background-image: 
            linear-gradient(
                color-mix(in srgb, var(--color-light) 0%, transparent),
                color-mix(in srgb, var(--color-dark) 100%, transparent)
            );
    }

    .player-lastname {
        font-size: var(--text-base);
        color: var(--color-light);
    }

    .player-firstname {
        font-size: var(--text-base);
        color: var(--color-light);
    }

    .player-position {
        font-size: var(--text-xs);
        color: color-mix(in srgb, var(--color-light) 65%, transparent);
    }

    @media (min-width: 1024px) {
        .player-card {
            height: 380px;
        }

        .player-number {
            font-size: var(--text-display);
            top: 15%;
            
        }

        .player-lastname,
        .player-firstname {
            font-size: var(--text-xl);
        }

        .player-position {
            font-size: var(--text-lg);
        }
    }
</style>