---
// Import wbudowanego komponentu do obrazków
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<header class="main-header">
    <div class="header-content container">
        <a href="/" class="logo-link">
            <Image src={logo} alt="MMKS Jutrzenka Płock" width={170} class="logo-image" />
        </a>

        <nav class="desktop-nav">
            <a href="#o-nas" class="nav-link">O nas</a>
            <a href="#tabela" class="nav-link">Tabela</a>
            <a href="#aktualnosci" class="nav-link">Aktualności</a>
            <a href="#mecze" class="nav-link">Mecze</a>
            <a href="#kontakt" class="nav-link">Kontakt</a>
        </nav>

        <div class="right-section">
            <div class="social-links">
                <a href="#" class="social-icon">FB</a>
                <a href="#" class="social-icon">IG</a>
                <a href="#" class="social-icon">TT</a>
            </div>

            <a href="#" class="cta-button">KUP BILET</a>

            <button class="hamburger-btn">☰</button>
        </div>
    </div>
</header>

<style>
    .main-header {
        background-color: var(--color-primary);
        border-bottom: 2px solid var(--color-light);
        height: 80px;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: 100%;
    }

    .right-section {
        display: flex;
        align-items: center;
        gap: var(--space-md);
    }

    .desktop-nav, .social-links, .cta-button {
        display: none; 
    }

    .hamburger-btn {
        background: none;
        border: none;
        color: var(--color-light);
        font-size: var(--text-2xl);
    }

    .logo-image {
        margin-bottom: -90px;
        
    }

    @media (min-width: 1024px) {
        .hamburger-btn {
            display: none; 
        }

        .desktop-nav {
            display: flex; 
            gap: var(--space-xl);
        }

        .nav-link {
            color: var(--color-light);
            text-decoration: none;
            font-weight: var(--weight-bold);
            font-size: var(--text-base);
            text-transform: uppercase;
            padding: var(--space-lg) var(--space-md);
            border-bottom: 3px solid transparent;
            transition: all 0.2s ease;
        }

        .nav-link:hover {
            border-bottom-color: var(--color-light);
            background-color: var(--color-primary-dark);
        }

        .social-links, .cta-button {
            display: flex;
        }

        .social-links {
            gap: var(--space-sm);
        }

        .social-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background-color: var(--color-dark);
            color: var(--color-light);
            text-decoration: none;
            border-radius: 4px;
        }

        .cta-button {
            background-color: var(--color-dark);
            color: var(--color-light);
            text-decoration: none;
            padding: var(--space-sm) var(--space-md);
            height: 36px;
            border-radius: var(--radius-sm);
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-sm);
        }
    }
</style>