---
import MatchCard from './MatchCard.astro';
---

<section class="hero-section">
    <div class="hero-content container">
        <MatchCard />
    </div>

</section>

<style>
    .hero-section {
        display: flex;
        min-height: 255px;
        background-image:
            linear-gradient(
                to bottom,
                rgba(0, 65, 94, 0.6) 0%,
                rgba(0, 0, 0, 0.6) 100%
            ),
            url('../assets/hero-bg.jpg');
        background-size: cover;
        background-position: center;
    }

    .hero-content {
        display: flex;
        width: 100%;
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 1024px) {
        .hero-section {
            min-height: 600px;
        }
    }

</style>