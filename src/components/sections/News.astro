---
import SectionHeader from "@/components/SectionHeader.astro";
import NewsCard from "@/components/NewsCard.astro";
---


<section class="news-section">
    <div class="news-content container">
        <SectionHeader title="Aktualności" kicker="Co się dzieje?" variant="dark"/>
        <NewsCard variant="main" content="Kolejny mecz, tym razem na naszej drodze..." />        <NewsCard/>
        <NewsCard variant="secondary" content="Wygrywamy z SMS ZPRP Płock..." />
        <NewsCard variant="secondary" content="Podsumowanie weekendu ligowego..." />
    </div>
    
</section>

<style>
    .news-section {
        display: flex;
        background-image: 
            linear-gradient(
                color-mix(in srgb, var(--color-secondary) 90%, transparent),
                color-mix(in srgb, var(--color-secondary) 90%, transparent)
            ),
            url('@/assets/hero-bg.jpg');
            
        background-size: cover;
        background-position: center;
    }

    .news-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }
</style>