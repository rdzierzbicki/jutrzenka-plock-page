---
import SectionHeader from "@/components/SectionHeader.astro";
import NewsCard from "@/components/NewsCard.astro";
---


<section class="news-section">
    <div class="news-content container">
        <SectionHeader title="Aktualności" kicker="Co się dzieje?" variant="dark"/>
        
        <div class="news-grid">
            <div class="grid-main">
                <NewsCard/>
            </div>

            <div class="grid-sub">
                <NewsCard/>
            </div>

            <div class="grid-sub">
                <NewsCard/>
            </div>

            <div class="grid-sub desktop-only">
                <NewsCard/>
            </div>

            <div class="grid-sub desktop-only">
                <NewsCard/>
            </div>
        </div>
    </div>
    
</section>

<style>
    .news-section {
        display: flex;
        background-image: 
            linear-gradient(
                color-mix(in srgb, var(--color-secondary) 90%, transparent),
                color-mix(in srgb, var(--color-secondary) 90%, transparent)
            ),
            url('@/assets/hero-bg.jpg');
            
        background-size: cover;
        background-position: center;
        /* padding: var(--space-xl) 0; */ /* temp to check */ 
    }

    .news-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        width: 100%;
    }

    .news-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-md);
    }

    .grid-main {
        grid-column: span 2;
        height: 190px; /* TODO: need to refactor card */
    }

    .grid-sub {
        height: 150px;
    }

    .desktop-only {
        display: none;
    }

    @media (min-width: 1024px) {
        .news-grid {
            grid-template-columns: 1.3fr 1fr 1fr;
            grid-template-rows: 175px 175px;
            gap: var(--space-lg);;
        }

        .grid-main {
            grid-column: 1 / 2;
            grid-row: 1 / 3;
            height: 100%;
        }

        .grid-sub {
            height: 100%;
        }

        .desktop-only {
            display: block;
        }
    }
</style>